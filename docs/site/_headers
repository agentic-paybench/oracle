# Cloudflare Pages response headers.
#
# Force edge revalidation so a removed or changed file propagates immediately:
# static assets (.md/.json) otherwise default to a 7-day s-maxage in edge
# cache, so a stale copy could be served long after a change.
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer

# The vendored typefaces never change under the same file name (a new face
# arrives as a new file), so they may be cached for a year.
/family/fonts/*
  Cache-Control: public, max-age=31536000, immutable
