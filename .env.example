# Cloudflare Pages deploy credentials for the Day-0 oracle read surface.
# Copy to .env (gitignored; Syncthing-carried between hosts, never committed) and fill in.
# For the CI-gated deploy, set these as GitHub Actions repo secrets instead
# (see .github/workflows/pages-cloudflare.yml): gh secret set CLOUDFLARE_API_TOKEN ...
#
# Local manual deploy:
#   set -a; . ./.env; set +a
#   bash docs/site/build-site.sh && npx wrangler@3 pages deploy docs/site --project-name agentic-paybench-oracle

# API token scoped to "Cloudflare Pages: Edit" (+ Account: Read).
CLOUDFLARE_API_TOKEN=

# Account ID from the Cloudflare dashboard (Workers & Pages overview, right sidebar).
CLOUDFLARE_ACCOUNT_ID=

# --- Right-of-reply L3 review: remote R2 read access -------------------------
# Scoped API token for reading the append-only reply-pending bucket during L3
# review (see the maintainer's L3 review runbook). Scope it
# to "Workers R2 Storage: Read" on the reply-pending bucket ONLY (least privilege;
# do NOT reuse the Pages token above). wrangler reads the single CLOUDFLARE_API_TOKEN
# var, so export this token AS that var per pull:
#   CLOUDFLARE_API_TOKEN="$R2_READ_API_TOKEN" \
#     npx wrangler r2 object get reply-pending/pending/<id> --remote --file <local>
# (Object enumeration is dashboard or R2 S3 API only; wrangler has no object list.)
R2_READ_API_TOKEN=
